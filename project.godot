; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tilt-the-sky"
run/main_scene="uid://btnddokgoef2l"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
DialogueManager="*uid://c3rodes2l3gxb"
LoadingManager="*uid://bgtti7snd6uci"
PlayerManager="*uid://c4c2iuqc4guop"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/custom_font="uid://dhasmj665nsik"

